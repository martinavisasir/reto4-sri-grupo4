// Zona directa del Grupo 4
zone "grupo4reto4.eus" {
    type master;
    file "/etc/bind/db.grupo4reto4.eus";
    allow-transfer { 192.168.4.102; };
    also-notify { 192.168.4.102; };
};

// Zona inversa de nuestra red Proxmox (192.168.4.0/24)
zone "4.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/db.192.168.4";
    allow-transfer { 192.168.4.102; };
    also-notify { 192.168.4.102; };
};
